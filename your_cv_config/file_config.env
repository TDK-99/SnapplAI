# ============================================================
# SnapplAI — your search settings
# Edit the values below, commit/push, and the GitHub Action
# (and any local run of `python main.py`) will pick them up.
# Never put secrets here (API keys, passwords) — those go in
# GitHub Secrets, see README.md.
# ============================================================

# dont modify this
site_name=linkedin

# the role you are looking for
search_term=Data Analyst

# check the supported country list: https://github.com/Bunsly/JobSpy - for multi country write like this "Italy,UK"
location=Italy,Spain,Denmark,United States

# countries to EXCLUDE from results (e.g. "United States,United Kingdom") -
# useful when location is empty (searching all countries) and you don't want
# some of them. Leave empty ("") for no exclusion
country_no=Italy,United States

# leave empty ("") for no filter city - "Milan" for one city - "Milan,Rome" for more than one city
city=""

# Max 100 results per run. For multiple countries, split evenly:
# e.g. 3 countries -> ~33 each (100 / 3)
# if you put one and more city put min 50
results_wanted=17

# how many hours old a post can be
hours_old=24

# this should be always True
linkedin_fetch_description=True

# leave empty ("") if you are interested also in on-site work
work_from_home=True

# if you consider to work full remote insert True, if not leave empty ("")
remote_only=""

# modify after you drop your CV in this folder
dir_cv=./your_cv_config/Valerio_Mezzopra_CV.pdf

# this is the filter for the ai score, so the data will filter for your
# number and up - suggested 7 for 7-8-9-10 fit cv/JD
score_config=7
